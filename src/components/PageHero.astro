---
import LogoMark from "./LogoMark.astro";

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  back?: { href: string; text: string };
}

const { eyebrow, title, intro, back } = Astro.props;
---

<section class="relative overflow-hidden bg-ink text-paper">
  <div
    class="absolute inset-0 bg-cover bg-center opacity-20 mix-blend-luminosity"
    style="background-image: url('/peloton-meilsen-2025.webp')"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/90 to-ink/40" aria-hidden="true"></div>
  <LogoMark
    class="pointer-events-none absolute -right-24 top-1/2 hidden h-[28rem] w-[28rem] -translate-y-1/2 text-paper/[0.05] md:block"
  />

  <div class="wrap relative pb-14 pt-12 md:pb-20 md:pt-20">
    {
      back && (
        <a
          href={back.href}
          class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-paper/70 transition-colors hover:text-signal"
        >
          <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
            <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.61l3.22 3.22a.75.75 0 1 1-1.06 1.06l-4.5-4.5a.75.75 0 0 1 0-1.06l4.5-4.5a.75.75 0 0 1 1.06 1.06L5.61 9.25h10.64A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
          </svg>
          {back.text}
        </a>
      )
    }
    {eyebrow && <p class="eyebrow text-signal">{eyebrow}</p>}
    <h1 class="font-display mt-4 max-w-4xl text-5xl sm:text-6xl md:text-8xl">{title}</h1>
    {intro && <p class="mt-6 max-w-2xl text-lg text-paper/75 md:text-xl">{intro}</p>}
    <slot />
  </div>
</section>
