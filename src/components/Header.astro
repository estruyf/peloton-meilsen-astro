---
import LogoMark from "./LogoMark.astro";

const navItems = [
  { href: "/#agenda", text: "Agenda" },
  { href: "/fotogalerij", text: "Fotogalerij" },
  { href: "/rangschikking", text: "Rangschikking" },
  { href: "/veiligheid", text: "Veiligheid" },
  { href: "/#documenten", text: "Documenten" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  !href.startsWith("/#") && (path === href || path.startsWith(`${href}/`));
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-paper/10 bg-ink/95 text-paper backdrop-blur supports-[backdrop-filter]:bg-ink/85"
>
  <nav class="wrap flex h-16 items-center justify-between gap-6 md:h-20" aria-label="Hoofdnavigatie">
    <a href="/" class="group flex items-center gap-3" aria-label="Peloton Meilsen — home">
      <LogoMark class="h-9 w-9 text-paper transition-transform duration-300 group-hover:rotate-[-12deg] md:h-10 md:w-10" />
      <span class="font-display text-xl leading-none tracking-wide md:text-2xl">
        Peloton <span class="text-signal">Meilsen</span>
      </span>
    </a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? "page" : undefined}
              class="relative rounded-full px-4 py-2 text-sm font-medium text-paper/75 transition-colors hover:text-paper aria-[current=page]:text-paper aria-[current=page]:after:absolute aria-[current=page]:after:inset-x-4 aria-[current=page]:after:-bottom-0.5 aria-[current=page]:after:h-0.5 aria-[current=page]:after:bg-signal"
            >
              {item.text}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href="/lidmaatschap"
        aria-current={isActive("/lidmaatschap") ? "page" : undefined}
        class="btn-signal hidden px-4 py-2.5 sm:inline-flex"
      >
        Word lid
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
          <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"></path>
        </svg>
      </a>

      <button
        id="nav-toggle"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-paper/20 text-paper transition hover:border-paper lg:hidden"
        aria-label="Menu openen"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="relative block h-3.5 w-5" aria-hidden="true">
          <span class="bar absolute left-0 top-0 h-0.5 w-5 bg-current transition-transform duration-300"></span>
          <span class="bar absolute left-0 top-1.5 h-0.5 w-5 bg-current transition-opacity duration-300"></span>
          <span class="bar absolute left-0 top-3 h-0.5 w-5 bg-current transition-transform duration-300"></span>
        </span>
      </button>
    </div>
  </nav>
</header>

<div
    id="mobile-menu"
    class="fixed inset-x-0 bottom-0 top-16 z-[45] hidden overflow-y-auto bg-ink text-paper md:top-20 lg:hidden"
  >
    <div class="wrap flex min-h-full flex-col py-10">
      <ul class="space-y-1">
        {
          navItems.map((item, i) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? "page" : undefined}
                class="group flex items-baseline gap-4 border-b border-paper/10 py-4 aria-[current=page]:text-signal"
              >
                <span class="text-xs font-semibold tabular-nums text-paper/40">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="font-display text-5xl transition-transform group-hover:translate-x-2">
                  {item.text}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <a href="/lidmaatschap" class="btn-signal mt-10 self-start px-6 py-4 text-base">
        Word lid van de club
      </a>
      <p class="mt-auto pt-12 text-sm text-paper/60">
        Vragen? Mail naar
        <a href="mailto:info@pelotonmeilsen.be" class="text-paper underline underline-offset-4">
          info@pelotonmeilsen.be
        </a>
      </p>
    </div>
</div>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Menu sluiten" : "Menu openen");
    menu.classList.toggle("hidden", !open);
    document.body.classList.toggle("overflow-hidden", open);
  }

  toggle?.addEventListener("click", () => {
    setOpen(toggle.getAttribute("aria-expanded") !== "true");
  });

  // Close when navigating (incl. same-page anchors) or pressing Escape
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
      setOpen(false);
      toggle.focus();
    }
  });
  window.matchMedia("(min-width: 1024px)").addEventListener("change", (e) => {
    if (e.matches) setOpen(false);
  });
</script>

<style>
  #nav-toggle[aria-expanded="true"] .bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  #nav-toggle[aria-expanded="true"] .bar:nth-child(2) {
    opacity: 0;
  }
  #nav-toggle[aria-expanded="true"] .bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
