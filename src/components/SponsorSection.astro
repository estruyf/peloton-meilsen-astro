---
const sponsors = [
  {
    name: "Struyf Consulting",
    logo: "/sponsors/struyf-consulting.svg",
    website: "https://struyfconsulting.be",
  },
  {
    name: "ADR Construct",
    logo: "/sponsors/adr.png",
    website: "https://www.adrconstruct.be",
  },
  {
    name: "De Gruyter BVBA",
    logo: "/sponsors/de-gruyter.png",
    website: "https://www.dgr.be",
  },
  {
    name: "Hans Cools",
    logo: "/sponsors/hans-cools.png",
    website: "https://www.coolsverf.be",
  },
];
---

<section class="bg-ink text-paper" aria-labelledby="sponsors-title">
  <div class="wrap py-16 md:py-24">
    <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow text-signal">Met dank aan</p>
        <h2 id="sponsors-title" class="font-display mt-3 text-4xl md:text-6xl">Onze sponsors</h2>
      </div>
      <p class="max-w-sm text-paper/60">
        Zij maken onze clubkledij en activiteiten mogelijk. Rij je langs? Steun
        ze terug.
      </p>
    </div>

    <ul class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-3xl border border-paper/10 bg-paper/10 lg:grid-cols-4">
      {
        sponsors.map((sponsor) => (
          <li class="bg-ink">
            <a
              href={sponsor.website}
              class="group flex h-full min-h-[9rem] items-center justify-center p-8 transition-colors hover:bg-ink-600 md:min-h-[11rem]"
              target="_blank"
              rel="noopener noreferrer"
              title={sponsor.name}
            >
              <img
                src={sponsor.logo}
                alt={`${sponsor.name} logo`}
                class="max-h-16 w-auto max-w-full object-contain opacity-80 transition-opacity group-hover:opacity-100"
                loading="lazy"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
