---
import Layout from "../layouts/Layout.astro";
import Calendar from "../components/Calendar.astro";
import Documents from "../components/Documents.astro";
import LogoMark from "../components/LogoMark.astro";
import { NextRide } from "../components/NextRide";

const pillars = [
  {
    nr: "01",
    title: "Eén peloton",
    text: "We vertrekken samen en komen samen binnen. Gaat de rit richting polders, dan rijdt een snellere groep een extra lus — zo rolt iedereen tegelijk terug binnen.",
  },
  {
    nr: "02",
    title: "Veiligheid voorop",
    text: "Een helm is verplicht, wegkapiteins bepalen stop & start en bij pech wacht de hele groep. Onveilige situaties worden doorgegeven tot de laatste man.",
  },
  {
    nr: "03",
    title: "Het sociale primeert",
    text: "Sportief van karakter, maar zonder verplichtingen. Respect voor iedereen — bestuurslid, wegkapitein of kopman — en ook buiten het zadel zien we elkaar graag.",
  },
];
---

<Layout title="Home">
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-ink text-paper">
    <img
      src="/peloton-meilsen-club-2025.webp"
      alt=""
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_35%]"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/70 to-ink/30"
      aria-hidden="true"
    >
    </div>
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-ink/80 via-ink/20 to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="wrap flex min-h-[calc(100svh-4rem)] flex-col justify-end pb-10 pt-24 md:min-h-[calc(100svh-5rem)] md:pb-16">
      <p class="eyebrow text-signal">Peloton Meilsen · Wielerclub</p>
      <h1 class="font-display mt-8 text-[22vw] leading-[0.82] sm:text-[18vw] lg:text-[12.5rem]">
        <span class="sr-only">Peloton Meilsen — </span>Eén<br />Peloton<span class="text-signal">.</span>
      </h1>

      <div class="mt-8 flex flex-col gap-8 md:mt-12 md:flex-row md:items-end md:justify-between">
        <div class="max-w-xl">
          <p class="text-lg text-paper/85 md:text-xl">
            Doe mee met onze gepassioneerde fietsgemeenschap voor onvergetelijke
            ritten en blijvende vriendschappen.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#agenda" class="btn-signal px-6 py-3.5">Bekijk de agenda</a>
            <a href="/lidmaatschap" class="btn-ghost-light px-6 py-3.5">Word lid</a>
          </div>
        </div>

        <NextRide client:only="react" />
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="wrap py-16 md:py-28" aria-labelledby="over-ons">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <p class="eyebrow text-kit">Over onze club</p>
        <h2 id="over-ons" class="font-display mt-3 text-5xl md:text-7xl">
          Meer dan een wielerclub
        </h2>
      </div>
      <div class="lg:col-span-7 lg:pt-10">
        <p class="text-xl leading-relaxed text-ink md:text-2xl">
          Peloton Meilsen is een gemeenschap van gepassioneerde fietsers die een
          liefde voor de sport en de open weg delen. We zitten liever op de vélo
          dan achter een bureau.
        </p>
        <ul class="mt-8 flex flex-wrap gap-2">
          <li class="rounded-full border border-ink/15 px-4 py-2 text-sm font-medium">
            Wekelijkse groepsritten voor alle niveaus
          </li>
          <li class="rounded-full border border-ink/15 px-4 py-2 text-sm font-medium">
            Woensdagrit met vrije strook
          </li>
          <li class="rounded-full border border-ink/15 px-4 py-2 text-sm font-medium">
            Sociale evenementen &amp; bijeenkomsten
          </li>
        </ul>
      </div>
    </div>

    <div class="road-stripe mt-16 text-ink/15" aria-hidden="true"></div>

    <ol class="mt-12 grid gap-10 md:grid-cols-3 md:gap-8">
      {
        pillars.map((p) => (
          <li>
            <span class="font-display text-6xl text-ink/15">{p.nr}</span>
            <h3 class="mt-3 text-2xl font-bold">{p.title}</h3>
            <p class="mt-3 leading-relaxed text-ink/70">{p.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="border-y border-ink/10 bg-paper-200/60">
    <Calendar />
  </div>

  <!-- Club photo -->
  <section class="relative isolate overflow-hidden bg-ink text-paper" aria-labelledby="clubfoto">
    <img
      src="/peloton-meilsen-club-2025.webp"
      alt="Groepsfoto van de leden van Peloton Meilsen in clubkledij, 2025"
      class="h-[60vh] min-h-[22rem] w-full object-cover md:h-auto md:max-h-[85vh]"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-ink/10 md:via-ink/10 md:to-transparent" aria-hidden="true"></div>
    <div class="wrap absolute inset-x-0 bottom-0 flex flex-col gap-6 pb-10 md:flex-row md:items-end md:justify-between md:pb-14">
      <div>
        <p class="eyebrow text-signal">De club</p>
        <h2 id="clubfoto" class="font-display mt-3 text-5xl md:text-7xl">Eén kleur,<br />één peloton</h2>
      </div>
      <a href="/fotogalerij" class="btn-ghost-light self-start bg-ink/40 backdrop-blur md:self-auto">
        Naar de fotogalerij
      </a>
    </div>
  </section>

  <!-- Join CTA -->
  <section class="relative overflow-hidden bg-signal text-ink">
    <LogoMark class="pointer-events-none absolute -right-20 -top-24 h-[26rem] w-[26rem] text-ink/[0.07]" />
    <div class="wrap relative flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between md:py-20">
      <div class="max-w-2xl">
        <h2 class="font-display text-5xl md:text-7xl">Zin om mee te rijden?</h2>
        <p class="mt-4 text-lg text-ink/80">
          Iedereen die door de raad van bestuur wordt aanvaard kan lid worden.
          Vul het formulier in en we nemen snel contact met je op.
        </p>
      </div>
      <a href="/lidmaatschap" class="btn-ink shrink-0 self-start px-7 py-4 text-base md:self-auto">
        Word lid
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4">
          <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.64l-3.22-3.22a.75.75 0 1 1 1.06-1.06l4.5 4.5a.75.75 0 0 1 0 1.06l-4.5 4.5a.75.75 0 1 1-1.06-1.06l3.22-3.22H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>
  </section>

  <Documents />
</Layout>
