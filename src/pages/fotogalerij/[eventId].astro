---
import { format } from "date-fns";
import { nl } from "date-fns/locale/nl";
import Layout from "../../layouts/Layout.astro";
import Documents from "../../components/Documents.astro";
import PageHero from "../../components/PageHero.astro";
import { GalleryEventDetail } from "../../components/GalleryEventDetail";

export async function getStaticPaths() {
  // Import all gallery data files at build time
  const galleryModules = import.meta.glob("../../data/gallery/*.json", {
    eager: true,
  });
  const events = Object.values(galleryModules).map(
    (module: any) => module.default || module
  );

  return events.map((event) => ({
    params: { eventId: event.id },
    props: { event },
  }));
}

const { event } = Astro.props;
const eyebrow = [
  event.date ? format(new Date(event.date), "d MMMM yyyy", { locale: nl }) : null,
  `${event.images.length} foto's`,
]
  .filter(Boolean)
  .join(" · ");
---

<Layout title={event.title || "Fotogalerij"} description={event.description}>
  <PageHero
    eyebrow={eyebrow}
    title={event.title}
    intro={event.description}
    back={{ href: "/fotogalerij", text: "Terug naar de galerij" }}
  />

  <section class="wrap py-12 md:py-20">
    <GalleryEventDetail eventId={event.id} initialEvent={event} client:load />
  </section>

  <Documents />
</Layout>
