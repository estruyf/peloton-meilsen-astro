---
import Layout from "../layouts/Layout.astro";
import Documents from "../components/Documents.astro";
import PageHero from "../components/PageHero.astro";
import RiderStats from "../components/RiderStats";
---

<Layout
  title="Rangschikking"
  description="De rangschikking van Peloton Meilsen op basis van het aantal gereden ritten."
>
  <PageHero
    eyebrow="Leaderboard"
    title="Rangschikking"
    intro="De rangschikking wordt opgemaakt op basis van het aantal ritten dat je hebt gereden. Hoe meer ritten je rijdt, hoe hoger je in de rangschikking komt te staan."
  />

  <section class="wrap py-16 md:py-24">
    <RiderStats client:load />

    <p class="mt-10 text-sm text-ink/60">
      Denk je dat er een fout in de rangschikking zit? Neem dan contact op met
      iemand van het bestuur.
    </p>
  </section>

  <Documents />
</Layout>
